{
 "dur": 50.299,
 "lines": [
  {
   "id": "l01",
   "scene": "hook",
   "text": "Main digital marketing karta hoon... lekin sach bataun? Followers se business nahi chalta.",
   "t0": 0.4,
   "t1": 5.6
  },
  {
   "id": "l02",
   "scene": "gap",
   "text": "Jo cheez sales laati hai, woh zyada tar pages pe hoti hi nahi.",
   "t0": 5.92,
   "t1": 10.129
  },
  {
   "id": "l03",
   "scene": "solution",
   "text": "Har post ke saath ek seedha raasta: post dekhi, WhatsApp kiya, order ho gaya.",
   "t0": 10.449,
   "t1": 15.148
  },
  {
   "id": "l04",
   "scene": "founder",
   "text": "Main Zarkhaiz, OutputDM ka founder. Hum 2018 se yahi kaam kar rahe hain.",
   "t0": 15.468,
   "t1": 20.288
  },
  {
   "id": "l05",
   "scene": "fear",
   "text": "Roz post ki tension nahi, camera ke saamne aana bhi zaroori nahi. Content hum banate hain.",
   "t0": 20.608,
   "t1": 25.266
  },
  {
   "id": "l06",
   "scene": "objection",
   "text": "Sochte hain chhota business hai, itna sab kis liye? Free review mein hum batayenge kahan se shuru karein.",
   "t0": 25.586,
   "t1": 31.281
  },
  {
   "id": "l07",
   "scene": "lifestyle",
   "text": "Socho, subah post lagi aur shaam tak WhatsApp pe orders aa gaye. Yahi normal hona chahiye.",
   "t0": 31.601,
   "t1": 36.943
  },
  {
   "id": "l08",
   "scene": "authority",
   "text": "Restaurants, real estate, health aur travel: Pakistan aur UAE ke businesses OutputDM chunte hain.",
   "t0": 37.263,
   "t1": 43.192
  },
  {
   "id": "l09",
   "scene": "cta",
   "text": "Free Digital Growth Review ke liye abhi WhatsApp karein.",
   "t0": 43.512,
   "t1": 46.106
  },
  {
   "id": "l10",
   "scene": "cta",
   "text": "OutputDM dot com.",
   "t0": 46.266,
   "t1": 47.699
  }
 ],
